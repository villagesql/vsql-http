# vsql_http — url_encode / url_decode tests
INSTALL EXTENSION vsql_http;
# url_encode: basic cases
SELECT vsql_http.url_encode('hello world');
vsql_http.url_encode('hello world')
hello%20world
SELECT vsql_http.url_encode('a=1&b=2');
vsql_http.url_encode('a=1&b=2')
a%3D1%26b%3D2
SELECT vsql_http.url_encode('');
vsql_http.url_encode('')

SELECT vsql_http.url_encode('no-encoding-needed');
vsql_http.url_encode('no-encoding-needed')
no-encoding-needed
SELECT vsql_http.url_encode('https://example.com/path?q=hello world');
vsql_http.url_encode('https://example.com/path?q=hello world')
https%3A%2F%2Fexample.com%2Fpath%3Fq%3Dhello%20world
# url_decode: basic cases
SELECT vsql_http.url_decode('hello%20world');
vsql_http.url_decode('hello%20world')
hello world
SELECT vsql_http.url_decode('a%3D1%26b%3D2');
vsql_http.url_decode('a%3D1%26b%3D2')
a=1&b=2
SELECT vsql_http.url_decode('');
vsql_http.url_decode('')

SELECT vsql_http.url_decode('no-decoding-needed');
vsql_http.url_decode('no-decoding-needed')
no-decoding-needed
# round-trip
SELECT vsql_http.url_decode(vsql_http.url_encode('hello world & more'));
vsql_http.url_decode(vsql_http.url_encode('hello world & more'))
hello world & more
# NULL handling
SELECT vsql_http.url_encode(NULL);
vsql_http.url_encode(NULL)
NULL
SELECT vsql_http.url_decode(NULL);
vsql_http.url_decode(NULL)
NULL
# Materialization: CREATE TABLE AS SELECT must size the column from
# max_result_length (the function's declared VEF_MAX_RESULT_LENGTH output
# cap), not from the width of the argument -- even for a deliberately
# tiny argument, the declared column width must reflect the real
# output cap, not shrink to fit. (The argument is a literal
# expression, not a SQL variable, so the server computes its width
# precisely instead of falling back to a generic large default for
# variables of unknown length.)
CREATE TABLE t_url_encode_materialize AS SELECT vsql_http.url_encode(REPEAT('!', 10)) AS v;
SELECT DATA_TYPE, CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 't_url_encode_materialize' AND COLUMN_NAME = 'v';
DATA_TYPE	CHARACTER_MAXIMUM_LENGTH
longtext	4294967295
DROP TABLE t_url_encode_materialize;
# url_decode declares no max_result_length: its output is never longer
# than its input, so the column is sized from the argument width.
CREATE TABLE t_url_decode_materialize AS SELECT vsql_http.url_decode('%41%42') AS v;
SELECT DATA_TYPE, CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 't_url_decode_materialize' AND COLUMN_NAME = 'v';
DATA_TYPE	CHARACTER_MAXIMUM_LENGTH
varchar	24
DROP TABLE t_url_decode_materialize;
UNINSTALL EXTENSION vsql_http;
