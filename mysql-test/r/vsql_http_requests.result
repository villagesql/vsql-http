# vsql_http — HTTP request tests (echo server)
# vsql_http wraps responses as: {"status":N,"content_type":"...","headers":[...],"content":"..."}
# The echo server's JSON body is nested in $.content.
INSTALL EXTENSION vsql_http;
# http_get: status 200, method is GET
SELECT
JSON_VALUE(r, '$.status') AS status,
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(r, '$.content')), '$.method') AS method
FROM (SELECT CONVERT(vsql_http.http_get(@echo_url) USING utf8mb4) AS r) t;
status	method
200	GET
# http_post: method is POST and body is transmitted
SELECT
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(r, '$.content')), '$.method') AS method,
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(r, '$.content')), '$.body') AS body
FROM (SELECT CONVERT(vsql_http.http_post(@echo_url, 'text/plain', 'hello') USING utf8mb4) AS r) t;
method	body
POST	hello
# http_delete: method is DELETE
SELECT JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(CONVERT(vsql_http.http_delete(@echo_url) USING utf8mb4), '$.content')), '$.method') AS method;
method
DELETE
# http_put: method and body
SELECT
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(r, '$.content')), '$.method') AS method,
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(r, '$.content')), '$.body') AS body
FROM (SELECT CONVERT(vsql_http.http_put(@echo_url, 'text/plain', 'data') USING utf8mb4) AS r) t;
method	body
PUT	data
# http_patch: method and body
SELECT
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(r, '$.content')), '$.method') AS method,
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(r, '$.content')), '$.body') AS body
FROM (SELECT CONVERT(vsql_http.http_patch(@echo_url, 'application/json', '{"x":1}') USING utf8mb4) AS r) t;
method	body
PATCH	{"x":1}
# http_request: custom header reaches server
SELECT JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(CONVERT(vsql_http.http_request('GET', @echo_url, '{"X-Test": "hi"}', NULL, NULL, NULL) USING utf8mb4), '$.content')), '$.headers."x-test"') AS x_test;
x_test
hi
# http_request: content-type is forwarded
SELECT JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(CONVERT(vsql_http.http_request('POST', @echo_url, NULL, 'payload', 'text/plain', NULL) USING utf8mb4), '$.content')), '$.headers."content-type"') AS content_type;
content_type
text/plain
# http_request: HEAD returns the status and empty content
SELECT
JSON_VALUE(r, '$.status') AS status,
JSON_VALUE(r, '$.content') = '' AS empty_content
FROM (SELECT CONVERT(vsql_http.http_request('HEAD', @echo_url, NULL, NULL, NULL, NULL) USING utf8mb4) AS r) t;
status	empty_content
200	1
SELECT JSON_VALUE(CONVERT(vsql_http.http_request('head', @echo_url, NULL, NULL, NULL, NULL) USING utf8mb4), '$.status') AS lowercase_head_status;
lowercase_head_status
200
# http_request: standard methods match case-insensitively and go out uppercase
SELECT
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(CONVERT(vsql_http.http_request('get', @echo_url, NULL, NULL, NULL, NULL) USING utf8mb4), '$.content')), '$.method') AS get_method,
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(CONVERT(vsql_http.http_request('Post', @echo_url, NULL, 'x', 'text/plain', NULL) USING utf8mb4), '$.content')), '$.method') AS post_method,
JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(CONVERT(vsql_http.http_request('delete', @echo_url, NULL, NULL, NULL, NULL) USING utf8mb4), '$.content')), '$.method') AS delete_method;
get_method	post_method	delete_method
GET	POST	DELETE
# http_request: a non-standard method is sent as given
SELECT JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(CONVERT(vsql_http.http_request('purge', @echo_url, NULL, NULL, NULL, NULL) USING utf8mb4), '$.content')), '$.method') AS purge_method;
purge_method
purge
# Materialization: CREATE TABLE AS SELECT must size the column from
# max_result_length (256KB), not from the width of the (short,
# literal) URL argument. A plain user variable's static type already
# carries a generic large width regardless of the fix, so the URL is
# substituted as a literal (via the MTR-level echo_port variable, not
# a SQL session variable) to actually exercise argument-width sizing.
# The echoed response, headers included, is far longer than the URL
# and must not come back as truncated (invalid) JSON.
SELECT JSON_VALID(CONVERT(v USING utf8mb4)) AS is_valid_json FROM t_http_get_materialize;
is_valid_json
1
SELECT JSON_VALUE(JSON_UNQUOTE(JSON_EXTRACT(CONVERT(v USING utf8mb4), '$.content')), '$.method') AS method FROM t_http_get_materialize;
method
GET
DROP TABLE t_http_get_materialize;
# NULL url returns NULL
SELECT vsql_http.http_get(NULL) IS NULL AS is_null;
is_null
1
# Connection refused returns NULL with a warning carrying curl's error
SELECT vsql_http.http_get('http://127.0.0.1:1/') IS NULL AS is_null;
is_null
1
Warnings:
Warning	3200	VDF error in function 'http_get': <curl error>
UNINSTALL EXTENSION vsql_http;
